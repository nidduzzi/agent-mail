#!/usr/bin/env bash
set -euo pipefail

readonly config_file="${AGENT_MAIL_CONFIG:-$HOME/.config/agent-mail/config}"

config_value() {
  local key="$1" default="$2" line=""
  if [ -n "${!key:-}" ]; then
    printf '%s' "${!key}"
    return
  fi
  if [ -f "$config_file" ]; then
    line="$(grep -E "^[[:space:]]*$key=" "$config_file" | tail -1 || true)"
  fi
  local value="${line#*=}"
  value="${value%\"}"
  value="${value#\"}"
  printf '%s' "${value:-$default}"
}

self="$(config_value AGENT_MAIL_SELF "")"
mailbox_dir="$(config_value AGENT_MAIL_DIR "$HOME/agent-mail")"
mailbox_dir="${mailbox_dir/#\~/$HOME}"
sync_check="$(config_value AGENT_MAIL_SYNC_CHECK "")"
poll_seconds="$(config_value AGENT_MAIL_POLL_SECONDS 5)"
stale_minutes="$(config_value AGENT_MAIL_STALE_MINUTES 30)"
readonly self mailbox_dir sync_check poll_seconds stale_minutes

readonly name_pattern='^[a-z0-9][a-z0-9-]*$'
readonly utc_minute_pattern='^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}$'
readonly presence_refresh_seconds=300
readonly members_dir="$mailbox_dir/members"
readonly lists_dir="$mailbox_dir/lists"
readonly deadline_file="$mailbox_dir/deadline"

if date -u -d @0 +%s >/dev/null 2>&1; then
  epoch_from_utc() { [[ "$1" =~ $utc_minute_pattern ]] && date -u -d "$1 UTC" +%s 2>/dev/null; }
  format_local() { date -d "@$1" "$2"; }
  format_utc() { date -u -d "@$1" "$2"; }
else
  epoch_from_utc() { [[ "$1" =~ $utc_minute_pattern ]] && date -u -j -f '%Y-%m-%d %H:%M' "$1" +%s 2>/dev/null; }
  format_local() { date -r "$1" "$2"; }
  format_utc() { date -u -r "$1" "$2"; }
fi

write_file_atomically() {
  local path="$1" content="$2"
  local partial
  partial="$(dirname "$path")/.$(basename "$path").tmp"
  printf '%s\n' "$content" > "$partial"
  mv "$partial" "$path"
}

field_of() {
  local file="$1" key="$2"
  sed -n "s/^$key: //p" "$file" | head -1
}

show_config() {
  printf '%s=%s\n' \
    AGENT_MAIL_CONFIG "$config_file" \
    AGENT_MAIL_SELF "${self:-(unset: the name of this agent in the mailbox)}" \
    AGENT_MAIL_DIR "$mailbox_dir" \
    AGENT_MAIL_SYNC_CHECK "${sync_check:-(none: command that must succeed while the sync runs)}" \
    AGENT_MAIL_POLL_SECONDS "$poll_seconds" \
    AGENT_MAIL_STALE_MINUTES "$stale_minutes"
}

mailbox_is_live() {
  if [ ! -d "$members_dir" ]; then
    echo "DEAD: no mailbox at $mailbox_dir (create one with: agent-mail init)" >&2
    return 2
  fi

  if [ -f "$deadline_file" ]; then
    local deadline_text deadline now
    deadline_text="$(head -1 "$deadline_file")"
    if ! deadline="$(epoch_from_utc "$deadline_text")"; then
      echo "DEAD: $deadline_file holds '$deadline_text', not a UTC 'YYYY-MM-DD HH:MM'" >&2
      return 2
    fi
    now="$(date -u +%s)"
    echo "AGENT-MAIL DEADLINE: $(format_utc "$deadline" '+%Y-%m-%d %H:%M UTC') ($(format_local "$deadline" '+%a %Y-%m-%d %H:%M %Z'))"
    if (( now >= deadline )); then
      echo "DEAD: the deadline passed $(( (now - deadline) / 60 )) min ago; the mailbox is closed" >&2
      return 2
    fi
    printf 'time left: %dh %02dm\n' $(( (deadline - now) / 3600 )) $(( (deadline - now) % 3600 / 60 ))
  else
    echo "AGENT-MAIL DEADLINE: none"
  fi

  if [ -n "$sync_check" ] && ! sh -c "$sync_check" >/dev/null 2>&1; then
    echo "DEAD: the sync check failed: $sync_check" >&2
    return 2
  fi
}

identity_is_ready() {
  if [ -z "$self" ]; then
    echo "no identity: set AGENT_MAIL_SELF for this agent (join first: agent-mail join <name>)" >&2
    return 1
  fi
  if [ ! -f "$members_dir/$self" ] || [ ! -d "$mailbox_dir/to-$self/read" ]; then
    echo "'$self' has not joined this mailbox (agent-mail join $self)" >&2
    return 1
  fi
}

minutes_since_seen() {
  local seen
  seen="$(field_of "$1" seen)"
  echo $(( ($(date -u +%s) - ${seen:-0}) / 60 ))
}

write_member() {
  local name="$1" role="$2" joined="$3"
  write_file_atomically "$members_dir/$name" "role: $role
host: $(hostname)
joined: $joined
seen: $(date -u +%s)"
}

record_presence() {
  local member="$members_dir/$self" seen
  seen="$(field_of "$member" seen)"
  if (( $(date -u +%s) - ${seen:-0} >= presence_refresh_seconds )); then
    write_member "$self" "$(field_of "$member" role)" "$(field_of "$member" joined)"
  fi
}

create_mailbox() {
  local deadline_text=""
  if [ "${1:-}" = --deadline ]; then
    deadline_text="${2:?usage: agent-mail init [--deadline 'YYYY-MM-DD HH:MM' (UTC)]}"
    if ! epoch_from_utc "$deadline_text" >/dev/null; then
      echo "the deadline must be a UTC 'YYYY-MM-DD HH:MM'" >&2
      return 1
    fi
  fi
  if [ -d "$members_dir" ]; then
    echo "a mailbox already exists at $mailbox_dir" >&2
    return 1
  fi
  mkdir -p "$members_dir" "$lists_dir"
  if [ -n "$deadline_text" ]; then
    write_file_atomically "$deadline_file" "$deadline_text"
  fi
  echo "created mailbox at $mailbox_dir${deadline_text:+, deadline $deadline_text UTC}"
}

join_mailbox() {
  local name="${1:?usage: agent-mail join <name> [role]}" role="${2:-}"
  local member="$members_dir/$name" joined
  if [[ ! "$name" =~ $name_pattern ]]; then
    echo "a name is lowercase letters, digits and dashes" >&2
    return 1
  fi
  joined="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  if [ -f "$member" ]; then
    local idle
    idle="$(minutes_since_seen "$member")"
    if (( idle < stale_minutes )); then
      echo "'$name' is taken: seen $idle min ago on $(field_of "$member" host)" >&2
      return 1
    fi
    echo "taking over '$name', idle for $idle min"
    joined="$(field_of "$member" joined)"
  fi
  mkdir -p "$mailbox_dir/to-$name/read"
  write_member "$name" "$role" "$joined"
  echo "joined as '$name'; this agent now needs AGENT_MAIL_SELF=$name"
}

leave_mailbox() {
  rm -f "$members_dir/$self"
  echo "'$self' left; its inbox to-$self/ is kept"
}

list_members() {
  local member name idle unread message
  printf '%-20s %-20s %-20s %-12s %s\n' NAME ROLE HOST LAST-SEEN UNREAD
  for member in "$members_dir"/*; do
    [ -f "$member" ] || continue
    name="$(basename "$member")"
    idle="$(minutes_since_seen "$member")"
    unread=0
    for message in "$mailbox_dir/to-$name"/*.md; do
      [ -e "$message" ] && unread=$(( unread + 1 ))
    done
    printf '%-20s %-20s %-20s %-12s %s\n' "$name" "$(field_of "$member" role)" "$(field_of "$member" host)" \
      "$( (( idle < stale_minutes )) && echo "${idle}m ago" || echo "stale ${idle}m")" "$unread"
  done
}

manage_lists() {
  local action="${1:-show}" list_name="${2:-}"
  case "$action" in
    show)
      local list
      for list in "$lists_dir"/*; do
        [ -f "$list" ] || continue
        if [ -z "$list_name" ] || [ "$(basename "$list")" = "$list_name" ]; then
          echo "@$(basename "$list"): $(tr '\n' ' ' < "$list")"
        fi
      done
      ;;
    set)
      [[ "$list_name" =~ $name_pattern ]] || { echo "usage: agent-mail list set <list> <member>..." >&2; return 1; }
      shift 2
      [ "$#" -gt 0 ] || { echo "a list needs at least one member" >&2; return 1; }
      local member unknown=""
      for member in "$@"; do
        [ -f "$members_dir/$member" ] || unknown="$unknown $member"
      done
      [ -z "$unknown" ] || { echo "not members:$unknown (see agent-mail who)" >&2; return 1; }
      write_file_atomically "$lists_dir/$list_name" "$(printf '%s\n' "$@")"
      echo "@$list_name: $*"
      ;;
    delete)
      rm -f "$lists_dir/${list_name:?usage: agent-mail list delete <list>}"
      echo "deleted @$list_name"
      ;;
    *)
      echo "usage: agent-mail list [show [list] | set <list> <member>... | delete <list>]" >&2
      return 1
      ;;
  esac
}

resolve_recipients() {
  local addressed="$1" item member members resolved="" unknown=""
  local -a items
  IFS=, read -r -a items <<<"$addressed"
  for item in "${items[@]}"; do
    case "$item" in
      @*)
        if [ ! -f "$lists_dir/${item#@}" ]; then
          unknown="$unknown $item"
          continue
        fi
        members="$(cat "$lists_dir/${item#@}")"
        ;;
      *) members="$item" ;;
    esac
    for member in $members; do
      [ "$member" = "$self" ] && continue
      if [ ! -d "$mailbox_dir/to-$member" ]; then
        unknown="$unknown $member"
        continue
      fi
      case " $resolved " in
        *" $member "*) ;;
        *) resolved="$resolved $member" ;;
      esac
    done
  done
  if [ -n "$unknown" ]; then
    echo "unknown recipients:$unknown (see agent-mail who and agent-mail list)" >&2
    return 1
  fi
  if [ -z "$resolved" ]; then
    echo "no recipients besides '$self'" >&2
    return 1
  fi
  echo $resolved
}

send_message() {
  local reply_to=""
  if [ "${1:-}" = --reply-to ]; then
    reply_to="${2:?usage: agent-mail send [--reply-to <id>] <recipients> <slug> < body.md}"
    shift 2
  fi
  local addressed="${1:?usage: agent-mail send [--reply-to <id>] <name,name,@list> <slug> < body.md}"
  local slug="${2:?usage: agent-mail send [--reply-to <id>] <name,name,@list> <slug> < body.md}"
  if [[ ! "$slug" =~ $name_pattern ]]; then
    echo "a slug is lowercase letters, digits and dashes" >&2
    return 1
  fi

  local recipients
  recipients="$(resolve_recipients "$addressed")" || return 1

  local body
  body="$(cat)"
  if [ -z "$body" ]; then
    echo "empty message" >&2
    return 1
  fi
  if grep -E -i -q '(password|passwd|secret|token|api[_-]?key|private[_-]?key)[[:space:]]*[=:][[:space:]]*[^[:space:]<]{6,}|BEGIN [A-Z ]*PRIVATE KEY' <<<"$body"; then
    echo "refused: the body looks like it carries a secret" >&2
    return 1
  fi

  local id message recipient
  id="$(date -u +%Y%m%dT%H%M%SZ)-$(od -An -N3 -tx1 /dev/urandom | tr -d ' \n')-from-$self-$slug"
  message="---
id: $id
from: $self
to: $(echo "$recipients" | sed 's/ /, /g')${reply_to:+
in-reply-to: $reply_to}
---
$body"
  for recipient in $recipients; do
    write_file_atomically "$mailbox_dir/to-$recipient/$id.md" "$message"
  done
  record_presence
  echo "sent $id to: $recipients"
}

list_mail() {
  local message inbox reply_to
  echo "unread in to-$self:"
  for message in "$mailbox_dir/to-$self"/*.md; do
    [ -e "$message" ] || continue
    reply_to="$(field_of "$message" in-reply-to)"
    echo "  $(basename "$message")  from $(field_of "$message" from)${reply_to:+  re $reply_to}"
  done
  echo "sent by $self, not yet read:"
  for inbox in "$mailbox_dir"/to-*; do
    for message in "$inbox"/*.md; do
      [ -e "$message" ] || continue
      if [ "$(field_of "$message" from)" = "$self" ]; then
        echo "  $(basename "$inbox")/$(basename "$message")"
      fi
    done
  done
  record_presence
}

acknowledge() {
  local message
  message="$(basename "${1:?usage: agent-mail ack <file in the inbox>}")"
  mv "$mailbox_dir/to-$self/$message" "$mailbox_dir/to-$self/read/$message"
  record_presence
  echo "acked: $message"
}

watch_inbox() {
  local announced=" " message failure
  for message in "$mailbox_dir/to-$self"/*.md; do
    [ -e "$message" ] && announced="$announced$(basename "$message") "
  done
  while true; do
    if ! failure="$(mailbox_is_live 2>&1 >/dev/null)"; then
      grep '^DEAD:' <<<"$failure"
      return 2
    fi
    for message in "$mailbox_dir/to-$self"/*.md; do
      [ -e "$message" ] || continue
      case "$announced" in
        *" $(basename "$message") "*) ;;
        *)
          announced="$announced$(basename "$message") "
          echo "NEW MAIL: $(basename "$message") from $(field_of "$message" from)"
          ;;
      esac
    done
    record_presence
    sleep "$poll_seconds"
  done
}

readonly usage="usage: agent-mail <command>
  config                                   resolved settings
  init [--deadline 'YYYY-MM-DD HH:MM']     create the mailbox at AGENT_MAIL_DIR (deadline in UTC)
  check                                    deadline first; exit 2 with DEAD: when closed
  join <name> [role]                       claim a name and an inbox
  who                                      members, last seen, unread counts
  leave                                    drop this agent's membership
  list [show [list] | set <list> <member>... | delete <list>]
  send [--reply-to <id>] <name,name,@list> <slug> < body.md
  inbox                                    unread mail, and own mail not yet read
  ack <file>                               mark a message read
  watch                                    print NEW MAIL lines until the mailbox dies"

command="${1:-}"
shift || true
case "$command" in
  config) show_config ;;
  init)   create_mailbox "$@" ;;
  check)  mailbox_is_live ;;
  join)   mailbox_is_live >/dev/null; join_mailbox "$@" ;;
  who)    mailbox_is_live; list_members ;;
  leave)  mailbox_is_live >/dev/null; identity_is_ready; leave_mailbox ;;
  list)   mailbox_is_live >/dev/null; manage_lists "$@" ;;
  send)   mailbox_is_live; identity_is_ready; send_message "$@" ;;
  inbox)  mailbox_is_live; identity_is_ready; list_mail ;;
  ack)    mailbox_is_live >/dev/null; identity_is_ready; acknowledge "$@" ;;
  watch)  mailbox_is_live >/dev/null; identity_is_ready; watch_inbox ;;
  *)      echo "$usage" >&2; exit 1 ;;
esac
